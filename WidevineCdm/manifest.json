{
  "manifest_version": 3,
  "name": "Widevine Content Decryption Module",
  "description": "Widevine Content Decryption Module by Google",
  "version": "4.10.2710.0",
  "icons": {
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
